# ---- App ----
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
# Vite dev server (5173) + built preview (4173)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Public tunnel (set to your ngrok URL when running live Twilio calls).
#   PUBLIC_URL     -> https base, with scheme
#   PUBLIC_WS_HOST -> host only, no scheme (used for wss:// media stream)
PUBLIC_URL=https://YOUR-SUBDOMAIN.ngrok-free.app
PUBLIC_WS_HOST=YOUR-SUBDOMAIN.ngrok-free.app

# ---- Database (Postgres async) ----
DATABASE_URL=postgresql+asyncpg://bharatbeat:bharatbeat@localhost:5432/bharatbeat
AUTO_CREATE_ALL=true
DEFAULT_COMPANY_CODE=colgate

# ---- Sarvam AI ----
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
SARVAM_STT_LANGUAGE=unknown
SARVAM_SAMPLE_RATE=8000
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
SARVAM_TTS_DEFAULT_LANGUAGE=hi-IN
SARVAM_LLM_MODEL=sarvam-105b
SARVAM_LLM_TEMPERATURE=0.2
# 'low'|null. sarvam-105b is a reasoning model — 'low' is required for it to hold
# the multi-step call and switch languages; null is faster but stalls on re-greeting.
SARVAM_REASONING_EFFORT=low

# ---- Twilio ----
# from_number MUST be a non-Indian voice-capable number to call +91 handsets.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VALIDATE_SIGNATURE=true
TWILIO_RECORD_CALLS=true

# ---- Supermemory ----
SUPERMEMORY_API_KEY=
SUPERMEMORY_API_URL=https://api.supermemory.ai

# ---- Demo handsets (used by scripts/seed.py + scripts/twilio_preflight) ----
# DEMO_HERO_PHONE      -> Bengaluru/Kannada hero outlet (Sri Lakshmi Stores).
#                         Point at your Twilio-VERIFIED number for the live demo.
# DEMO_RETAILER_PHONE  -> Salem/Tamil outlet (Kumar Stores); backup demo call.
# If DEMO_HERO_PHONE is unset it falls back to DEMO_RETAILER_PHONE.
DEMO_HERO_PHONE=
DEMO_RETAILER_PHONE=

# ---- Voice loop tuning (optional) ----
SILENCE_WATCHDOG_S=8.0
MAX_CALL_MINUTES=8

# ---- Scheduler (batch + future-scheduled call campaigns) ----
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=5.0
